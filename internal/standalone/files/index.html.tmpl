<!doctype html>
<!-- The app's page. Its <base href> is the absolute path the app is served under, which
     vite.config.ts's base agrees with: every relative URL the app reads, config.json among them,
     resolves under it, and the router's routes are relative to it. The build puts the theme
     module (src/theme.ts) ahead of the entry with blocking="render", so the stored theme is on
     the root before first paint. The header's Settings button, a foundation .button, opens
     <sl-theme-menu>, which the theme module defines, by the invoker command; its data-keys="s"
     binds S to it through the foundation's keys.js, which the entry loads. The router mounts each
     view in <main>; src/app.css lays out the header and the main column.
     Adapted from spike-html-apps (2883d78): test/consumers/app/index.html. -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="{{html .Base}}" />
    <title>{{html .Title}}</title>
    <script type="module" src="./src/main.ts"></script>
  </head>
  <body>
    <header>
      <h1>{{html .Title}}</h1>
      <button class="button" type="button" commandfor="settings" command="--open" data-keys="s">
        Settings <kbd>S</kbd>
      </button>
    </header>
    <main></main>
    <sl-theme-menu id="settings"></sl-theme-menu>
  </body>
</html>
