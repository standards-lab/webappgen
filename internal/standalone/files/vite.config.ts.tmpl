// The app's build (mise run build): index.html and src/ into dist/, with public/ copied beside
// them. base is the absolute path the app is served under, the one index.html's <base href> names,
// so the build's asset URLs agree with it.
// Adapted from spike-html-apps (2883d78): test/consumers/app/vite.config.ts, at an absolute base.
//
// CSS module scripts, `import sheet from "./x.css" with { type: "css" }`, which the components
// and the foundation's theme menu use to adopt their sheets, and which Vite doesn't support: the
// plugin rewrites each import carrying that attribute to a module whose default export is one
// constructed CSSStyleSheet per file; a plain `import "./x.css"` carries none, so Vite bundles it
// as CSS. include names the importers it parses, the layers' modules; outputMode pins the
// CSSStyleSheet the components adopt. It parses with rolldown/utils, which it doesn't declare, so
// package.json declares rolldown at the version Vite resolves.

import { defineConfig } from "vite";
import { standardCssModules } from "vite-plugin-standard-css-modules";

export default defineConfig({
  base: {{json .Base}},
  plugins: [
    standardCssModules({
      include: ["**/node_modules/@standards-lab/**/*.js"],
      outputMode: "CSSStyleSheet",
    }),
  ],
  build: {
    outDir: "dist",
    target: "es2024",
  },
});
